APP_NAME=DataDoctor
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

API_V1_PREFIX=/api/v1

HOST=0.0.0.0
PORT=8000

DATABASE_URL=postgresql+psycopg2://datadoctor:datadoctor@localhost:5432/datadoctor

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

UPLOAD_DIR=uploads
MODEL_DIR=models
REPORT_DIR=reports

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
